# App environment: development | production | preview
NEXT_PUBLIC_APP_ENV=development

# JustPrint connection mode: "mock" (local data, no backend) or "remote" (HTTP API)
NEXT_PUBLIC_JUSTPRINT_MODE=mock

# Base URL of the JustPrint production API (used only in remote mode).
# Example: https://www.justprint.app
# Embed preview path: {API}/embed/storefront-preview/{savedDesignId}?token=…&v=…
# Do not commit real secrets — NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_JUSTPRINT_API_URL=

# Default shop id used only in development when ?shop= is omitted
NEXT_PUBLIC_DEFAULT_SHOP=rawmoto
